{
  "name": "ultracode",
  "version": "2.0.0",
  "description": "多代理编排模式（dwf 引擎版，移植自 claude-code /ultracode）：把任务翻译成动态工作流脚本，引擎自主执行——typed ask 结构化输出、对抗验证质量模式、actor-Bash 并行 worktree 写入、resume/amend 断点续跑。附 v1.x Agent 通道 hooks 遗留兼容。",
  "author": {
    "name": "Simple6K"
  },
  "license": "MIT",
  "repository": "https://github.com/Simple6K/ultracode-zcode-agent",
  "keywords": [
    "multi-agent",
    "orchestration",
    "ultracode",
    "workflow"
  ],
  "skills": "skills",
  "commands": "commands",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/hooks/agent-concurrency-gate.mjs\"",
            "timeout": 10,
            "onError": "allow",
            "statusMessage": "ultracode 并发闸门"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/hooks/agent-ledger.mjs\"",
            "timeout": 10,
            "statusMessage": "ultracode 机制账本"
          }
        ]
      }
    ]
  }
}